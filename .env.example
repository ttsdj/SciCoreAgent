# BiocoreagentV2.0 model provider.
# Copy this file to .env and fill only your local machine's values.
# Never commit .env.
BIOCOREAGENT_PROVIDER=deepseek
BIOCOREAGENT_DEEPSEEK_API_KEY=replace-me
BIOCOREAGENT_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
BIOCOREAGENT_DEEPSEEK_MODEL=deepseek-chat

# Optional Postgres long-term memory. When unset, session chunks are retained
# in the local SQLite distillation outbox and the CLI remains fully offline.
# Install with: python -m pip install -e ".[memory-postgres]"
BIOCOREAGENT_MEMORY_POSTGRES_DSN=
# Optional tenant/user boundary for Postgres memory retrieval and distillation.
BIOCOREAGENT_MEMORY_USER_SCOPE=
# hash is deterministic/offline; sentence-transformers enables semantic Dense retrieval.
BIOCOREAGENT_EMBEDDING_BACKEND=hash
BIOCOREAGENT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional isolated OmicVerse backend. Keep heavy bioinformatics dependencies
# outside the main agent environment.
BIOCOREAGENT_OMICVERSE_ENABLED=0
BIOCOREAGENT_OMICVERSE_PYTHON=

# Optional remote bioinformatics workspace
BIO_REMOTE_HOST=
BIO_REMOTE_USER=
BIO_REMOTE_PORT=22
BIO_REMOTE_KEY=
BIO_REMOTE_WORK_DIR=
